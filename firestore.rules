rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do responsável: cada um só lê/escreve o próprio documento.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      // O responsável só acessa chats que ele mesmo abriu.
      allow read: if request.auth != null
        && resource.data.responsavelId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.responsavelId == request.auth.uid;

      // Atualização (ex.: marcar escalonado) permitida apenas ao dono do chat.
      // Em produção, a resposta da escola normalmente viria de um backend/admin
      // com uma role própria — aqui simplificado para o escopo do MVP.
      allow update: if request.auth != null
        && resource.data.responsavelId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId)).data.responsavelId == request.auth.uid;

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId)).data.responsavelId == request.auth.uid;
      }
    }
  }
}
